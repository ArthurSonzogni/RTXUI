prefix=@RTXUI_PC_PREFIX@
libdir=@RTXUI_PC_LIBDIR@
includedir=@RTXUI_PC_INCLUDEDIR@

Name: rtxui
Description: @PROJECT_DESCRIPTION@
URL: https://github.com/ArthurSonzogni/RTXUI
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -l$<TARGET_FILE_BASE_NAME:rtxui>
Libs.private: $<$<PLATFORM_ID:Windows>:-lgdi32 -luser32>
